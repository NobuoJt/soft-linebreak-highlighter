{"code":"import { Plugin } from \"obsidian\";\nimport { Decoration, ViewPlugin, WidgetType } from \"@codemirror/view\";\nimport { RangeSetBuilder } from \"@codemirror/state\";\nimport { syntaxTree } from \"@codemirror/language\";\nclass SoftBreakWidget extends WidgetType {\n    toDOM(view) {\n        return this.render();\n    }\n    render() {\n        const span = document.createElement(\"span\");\n        span.textContent = \"↵\";\n        span.style.color = \"skyblue\";\n        span.style.opacity = \"0.5\";\n        span.style.fontSize = \"80%\";\n        span.style.paddingLeft = \"0.2em\";\n        return span;\n    }\n}\nexport default class SoftBreakPlugin extends Plugin {\n    async onload() {\n        this.registerEditorExtension(ViewPlugin.fromClass(class {\n            constructor(view) {\n                this.decorations = this.buildDecorations(view);\n            }\n            update(update) {\n                if (update.docChanged || update.viewportChanged) {\n                    this.decorations = this.buildDecorations(update.view);\n                }\n            }\n            buildDecorations(view) {\n                const builder = new RangeSetBuilder();\n                for (let { from, to } of view.visibleRanges) {\n                    syntaxTree(view.state).iterate({\n                        from, to,\n                        enter: (node) => {\n                            // 除外: ヘッダー・リストなど\n                            if ([\"ListItem\", \"BulletList\", \"OrderedList\", \"ATXHeading\", \"SetextHeading\"].includes(node.type.name))\n                                return false;\n                            // 対象: ソフト改行を含む行\n                            if (node.type.name === \"Paragraph\") {\n                                const text = view.state.doc.sliceString(node.from, node.to);\n                                const lines = text.split(\"\\n\");\n                                let pos = node.from;\n                                for (let i = 0; i < lines.length - 1; i++) {\n                                    const line = lines[i];\n                                    if (line.endsWith(\"  \")) {\n                                        const deco = Decoration.widget({\n                                            widget: new SoftBreakWidget(),\n                                            side: 1\n                                        });\n                                        builder.add(pos + line.length, pos + line.length, deco);\n                                    }\n                                    pos += line.length + 1; // +1 for the \\n\n                                }\n                            }\n                        }\n                    });\n                }\n                return builder.finish();\n            }\n        }, {\n            decorations: v => v.decorations\n        }));\n    }\n}\n","references":["C:/Users/user/dev/soft-linebreak-highlighter/node_modules/obsidian/obsidian.d.ts","C:/Users/user/dev/soft-linebreak-highlighter/node_modules/@codemirror/view/dist/index.d.ts","C:/Users/user/dev/soft-linebreak-highlighter/node_modules/@codemirror/state/dist/index.d.ts","C:/Users/user/dev/soft-linebreak-highlighter/node_modules/@codemirror/language/dist/index.d.ts"]}
